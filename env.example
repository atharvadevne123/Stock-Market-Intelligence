# ============================================================
# Stock Market Intelligence - Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- Database ---
# PostgreSQL connection string for production
DATABASE_URL=postgresql://stockuser:stockpass@localhost:5432/stock_intelligence
# Use SQLite for local development / testing:
# DATABASE_URL=sqlite:///./dev.db

# --- Reddit API (optional, for PRAW scraping) ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=StockMarketIntelligence/1.0

# --- News API (optional) ---
NEWS_API_KEY=your_newsapi_org_key

# --- API Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- ML / NLP ---
# HuggingFace model name for FinBERT sentiment analysis
FINBERT_MODEL=ProsusAI/finbert
# Device: auto (default), cpu, cuda
FINBERT_DEVICE=auto
# Cache directory for downloaded models
TRANSFORMERS_CACHE=/tmp/hf_cache

# --- Security ---
# Comma-separated list of allowed CORS origins (use * to allow all)
CORS_ORIGINS=*
# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_in_production

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
